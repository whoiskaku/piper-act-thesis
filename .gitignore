# Phase 2 IMU reward pickle (36 MB, regeneratable)
outputs/eval/d2_imu_reward_computer*.pkl

# Local Claude harness state (per-machine, not for sharing)
.claude/

# MuJoCo mesh files (large STL/DAE, copied from external piper_ros repo)
lerobot-piper/sim/meshes/

# 冻结/运行记录(内含 commit hash, 提交会使其自指失效; 代码 commit 才是溯源锚点)
lerobot-piper/reports/FREEZE_*.json
