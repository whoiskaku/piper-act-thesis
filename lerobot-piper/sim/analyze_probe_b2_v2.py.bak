#!/usr/bin/env python3
"""B′ 分析器 v2（2026-07-27, 按用户三项阻断项重写统计口径）— 6-8Hz 复频响辨识。

奇/偶分解:
    Δy_odd  = (y_B+ − y_B−)/2                      线性增量, 噪声方差 0.5σ²(vs 1.5σ²)
    Δy_even = (y_B+ + y_B−)/2 − (y_A1 + y_A2)/2    应≈0; 否则=非线性/漂移/复放不一致

**H1 估计器**(跨窗, 逐通道)。不同窗相位不同 → ΣY/ΣU 会互相抵消, 方差暴涨:
    H1(f) = Σ_r Y_r(f) U_r*(f) / Σ_r |U_r(f)|²
    γ²(f) = |Σ_r Y_r U_r*|² / (Σ_r|U_r|² · Σ_r|Y_r|²)          ← 标准式
    小样本上偏 E[γ̂²] ≈ γ² + (1−γ²)/n_win → 同时报偏差修正值。

**保留三轴向量** H(f) ∈ C³, **不自动选主导轴**(同批噪声里取最大轴 = 选择偏差)。
与 Ĝ 比较用模型方向投影:
    z(f) = H_Ĝ^H H_real / (H_Ĝ^H H_Ĝ)     |z|=沿模型方向增益比, arg(z)=相位误差
    r(f) = H_real − z·H_Ĝ                  ‖r‖/‖H_real‖ = 方向失配比例
**附加时延拟合 arg(z) 的斜率**, 不拟合真实系统绝对相位 —— 共振本身制造相位变化,
只有相对模型的相位差才是"额外时延"。

时间戳: 锁相用**实际采样时刻** t_k, 天然处理抖动与丢样:
    X(f) = (2/N) Σ x_k exp(−j2πf t_k),  t_k 相对注入窗起点。

用法:
  python sim/analyze_probe_b2.py --self-test     # 三项验收(零噪声/蒙特卡洛/抖动)
  python sim/analyze_probe_b2.py --eps 0         # 分析真机
"""
from __future__ import annotations
import argparse
import json
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
PB = ROOT / "outputs/probe_b2"
FPS, NEXC, NDEC = 20.0, 40, 30
NANA = NEXC + NDEC          # **分析窗 = 激励 + 完整衰减**(burst FRF)
# 若分析窗只取激励段(40帧), 时延会把响应尾部推出窗外 → |z| 系统性低估 5-7%
# (实测: 时延75ms 使 |z| 1.000→0.932, 即使整数帧 100ms 也损失 6.3%)。
# 覆盖全衰减后 y=h*u 完整落在窗内 ⇒ DTFT 满足 Y(f)=H(f)U(f) 严格成立, 偏差消除。
JOINTS = {"j2": 1, "j3": 2}
AMPS = ("4mrad", "8mrad")


# ================================================================ 估计器
def lockin_at(x, t, f):
    """锁相于实际采样时刻 t(秒, 相对窗起点)。x: (n,) 或 (n,3)。"""
    x = np.asarray(x)
    w = np.exp(-2j * np.pi * f * np.asarray(t))
    if x.ndim > 1:
        w = w[:, None]
    return (2.0 / len(x)) * np.sum(x * w, axis=0)


def h1_coherence(U, Y):
    """H1 估计 + 标准相干度。U:(nw,), Y:(nw,C)。返回 (H, γ², γ²_偏差修正)。"""
    num = np.sum(Y * np.conj(U)[:, None], axis=0)
    su = np.sum(np.abs(U) ** 2)
    sy = np.sum(np.abs(Y) ** 2, axis=0)
    H = num / max(su, 1e-30)
    g2 = np.abs(num) ** 2 / np.maximum(su * sy, 1e-30)
    nw = len(U)
    g2c = np.clip((g2 * nw - 1) / max(nw - 1, 1), 0.0, 1.0)
    return H, g2, g2c


def project_on_model(H_real, H_G):
    """z = H_Ĝ^H H_real / (H_Ĝ^H H_Ĝ);  残差比 = ‖H_real − z H_Ĝ‖/‖H_real‖。"""
    d = float(np.vdot(H_G, H_G).real)
    z = np.vdot(H_G, H_real) / max(d, 1e-30)
    res = H_real - z * H_G
    return z, float(np.linalg.norm(res) / max(np.linalg.norm(H_real), 1e-30))


def extra_delay(zs, freqs):
    """τ_extra = −d arg(z)/dω (相对模型的附加时延, ms)。"""
    ph = np.unwrap(np.angle(np.asarray(zs)))
    w = 2 * np.pi * np.asarray(freqs, float)
    A = np.vstack([w, np.ones_like(w)]).T
    sol, *_ = np.linalg.lstsq(A, ph, rcond=None)
    r2 = 1 - np.sum((ph - A @ sol) ** 2) / max(np.sum((ph - ph.mean()) ** 2), 1e-30)
    return -sol[0] * 1e3, float(r2)


def frf(segs_u, segs_y, segs_t, freqs, segs_yG=None, nboot=1000):
    """逐频点: H(C³)、γ²、H_Ĝ、z、残差比、bootstrap CI。"""
    out = {}
    nw = len(segs_u)
    for f in freqs:
        U = np.array([lockin_at(u, t, f) for u, t in zip(segs_u, segs_t)])
        Y = np.array([lockin_at(y, t, f) for y, t in zip(segs_y, segs_t)])
        H, g2, g2c = h1_coherence(U, Y)
        rec = {"H": H, "gamma2": g2, "gamma2_corr": g2c, "n_win": nw}
        if segs_yG is not None:
            YG = np.array([lockin_at(y, t, f) for y, t in zip(segs_yG, segs_t)])
            HG, _, _ = h1_coherence(U, YG)
            z, frac = project_on_model(H, HG)
            rec.update({"H_G": HG, "z": z, "resid_frac": frac})
            rng = np.random.default_rng(0)
            bz = []
            for _ in range(nboot):
                k = rng.integers(0, nw, nw)
                Hb, _, _ = h1_coherence(U[k], Y[k])
                HGb, _, _ = h1_coherence(U[k], YG[k])
                bz.append(project_on_model(Hb, HGb)[0])
            bz = np.array(bz)
            rec["z_abs_ci"] = np.percentile(np.abs(bz), [2.5, 97.5])
            rot = np.angle(bz * np.exp(-1j * np.angle(z)))
            rec["z_phase_ci_deg"] = np.degrees(np.angle(z)) + \
                np.percentile(np.degrees(rot), [2.5, 97.5])
        out[float(f)] = rec
    return out


# ================================================================ 记录质量
def check_recording(imu100, dur_s, nominal_hz=100.0, verbose=True, name=""):
    """100Hz 记录验收: 实际频率/缺样率/最大间隔/重复/回退(按设备时间戳)。"""
    a = np.asarray(imu100, float)
    if a.size == 0:
        if verbose:
            print(f"  {name} 100Hz: ✗ 无样本")
        return {"ok": False, "why": "no samples"}
    ms = a[:, 1]
    d = np.diff(ms)
    pos = d[d > 0]
    step = float(np.median(pos)) if pos.size else float("nan")
    rate = 1000.0 / step if step > 0 else float("nan")
    exp_n = dur_s * nominal_hz
    miss = max(0.0, 1 - len(a) / exp_n)
    gap = float(d.max()) if d.size else 0.0
    dup, back = int(np.sum(d == 0)), int(np.sum(d < 0))
    ok = (abs(rate - nominal_hz) / nominal_hz < 0.05 and miss < 0.02
          and gap <= 3 * step and dup == 0 and back == 0)
    r = {"n": int(len(a)), "expect": int(exp_n), "rate_hz": rate,
         "missing_frac": miss, "max_gap_ms": gap, "dup": dup, "backward": back,
         "ok": bool(ok)}
    if verbose:
        print(f"  {name} 100Hz: {len(a)}/{exp_n:.0f} 样本  {rate:.1f}Hz  "
              f"缺样 {miss*100:.1f}%  最大间隔 {gap:.0f}ms  重复 {dup}  回退 {back}  "
              f"{'✓' if ok else '✗'}")
    return r


# ================================================================ 装配与分析
def segs(y, wins, n=NANA):
    return [y[w:w + n] for w in wins if w + n <= len(y)]


def analyze_cfg(A1, A2, Bp, Bm, seq, ts=None, verbose=True, label="", nboot=1000):
    wins = [int(w) for w in seq["wins"]]
    j, freqs = int(seq["joint"]), seq["freqs"]
    da = seq["da"][:, j]
    T = min(len(A1), len(A2), len(Bp), len(Bm), len(da))
    A1, A2, Bp, Bm, da = A1[:T], A2[:T], Bp[:T], Bm[:T], da[:T]
    wins = [w for w in wins if w + NANA <= T]
    pred = seq["pred"].mean(0)[:T]

    odd = (Bp - Bm) / 2.0
    even = (Bp + Bm) / 2.0 - (A1 + A2) / 2.0
    noise = (A2 - A1) / 2.0
    tt = ts if ts is not None else [np.arange(NANA) / FPS for _ in wins]
    fr = frf(segs(da, wins), segs(odd, wins), tt, freqs,
             segs_yG=segs(pred, wins), nboot=nboot)
    rms = lambda x: float(np.sqrt(np.mean(np.concatenate(segs(x, wins)) ** 2)))
    e_odd, e_even, e_noise = rms(odd), rms(even), rms(noise)
    zs = [fr[float(f)]["z"] for f in freqs]
    tau, r2 = extra_delay(zs, freqs)

    if verbose:
        print(f"\n── {label}  (j{j+1}, {len(wins)} 窗) ──")
        print(f"  奇 RMS {e_odd*1e3:6.1f} | 偶 {e_even*1e3:5.1f} | 噪声 {e_noise*1e3:5.1f} mrad/s"
              f" | 偶/奇 {e_even/max(e_odd,1e-12):.2f} "
              f"{'✓线性' if e_even < 0.5*e_odd else '⚠非线性/漂移'}")
        print(f"  {'f(Hz)':>6}{'‖H‖real':>10}{'‖H‖Ĝ':>9}{'|z|':>7}{'arg z':>8}"
              f"{'残差比':>8}{'γ²':>7}{'γ²修正':>8}{'|z| 95%CI':>16}")
        for f in freqs:
            d_ = fr[float(f)]
            print(f"{f:>6.1f}{np.linalg.norm(d_['H']):>10.2f}"
                  f"{np.linalg.norm(d_['H_G']):>9.2f}{abs(d_['z']):>7.2f}"
                  f"{np.degrees(np.angle(d_['z'])):>7.0f}°{d_['resid_frac']:>8.2f}"
                  f"{d_['gamma2'].mean():>7.2f}{d_['gamma2_corr'].mean():>8.2f}"
                  f"   [{d_['z_abs_ci'][0]:.2f},{d_['z_abs_ci'][1]:.2f}]")
        print(f"  相对 Ĝ 的附加时延 τ = {tau:+.0f} ms ({abs(tau)/50:.1f} 帧, R²{r2:.2f})"
              f"  ← 拟合 arg(z) 斜率, 已扣除共振自身相位")
    return {"fr": fr, "tau_ms": tau, "tau_r2": r2, "e_odd": e_odd,
            "e_even": e_even, "e_noise": e_noise, "n_win": len(wins)}


# ================================================================ 自检
def _synth(seq, g, tau_s, rot_deg, noise, seed, jitter_ms=0.0, drop_frac=0.0):
    """合成真机 = Ĝ预测 ⊗ (增益 g · 附加时延 τ · 方向旋转) + 噪声。

    时延用频域精确相移(支持分数帧)。返回 A1,A2,Bp,Bm, ts(抖动/丢样时刻或 None)。
    """
    rng = np.random.default_rng(seed)
    pred = seq["pred"].mean(0)
    T = len(pred)
    F = np.fft.rfft(pred, axis=0)
    fq = np.fft.rfftfreq(T, d=1 / FPS)
    y = np.fft.irfft(F * np.exp(-2j * np.pi * fq * tau_s)[:, None], n=T, axis=0) * g
    if rot_deg:
        c, s = np.cos(np.radians(rot_deg)), np.sin(np.radians(rot_deg))
        y = np.stack([c * y[:, 0] - s * y[:, 1], s * y[:, 0] + c * y[:, 1], y[:, 2]], 1)
    base = rng.normal(0, 0.3, (T, 3)).cumsum(0) * 0.01
    nz = (lambda: rng.normal(0, noise, (T, 3))) if noise > 0 else (lambda: 0.0)
    A1, A2 = base + nz(), base + nz()
    Bp, Bm = base + y + nz(), base - y + nz()
    ts = None
    if jitter_ms > 0 or drop_frac > 0:
        ts = [np.sort(np.arange(NANA) / FPS + rng.normal(0, jitter_ms * 1e-3, NANA))
              for _ in seq["wins"]]
    return A1, A2, Bp, Bm, ts


def self_test():
    seq = np.load(PB / "seq_ep0_j3_4mrad_p.npz", allow_pickle=True)   # 最弱响应
    freqs = seq["freqs"]
    NOISE, G_T, TAU_T, ROT_T = 0.050, 1.8, 0.075, 12.0
    print("=== 自检 (4mrad **最弱**响应; 噪声底 50 mrad/s 为 v2 实测) ===")

    # ① 零噪声 → 机器精度
    A1, A2, Bp, Bm, _ = _synth(seq, G_T, TAU_T, ROT_T, 0.0, 0)
    r = analyze_cfg(A1, A2, Bp, Bm, seq, verbose=False, nboot=50)
    zs = np.array([r["fr"][float(f)]["z"] for f in freqs])
    eg = abs(np.abs(zs).mean() - G_T) / G_T
    et = abs(r["tau_ms"] - TAU_T * 1e3)
    er = np.mean([r["fr"][float(f)]["resid_frac"] for f in freqs])
    tgt_r = np.sin(np.radians(ROT_T))
    print(f"① 零噪声: |z|={np.abs(zs).mean():.5f}(真{G_T}) 误差{eg*100:.4f}%  "
          f"τ={r['tau_ms']:.3f}ms(真{TAU_T*1e3:.0f}) 误差{et:.4f}ms")
    print(f"   逐频点相位误差: "
          f"{[f'{np.degrees(np.angle(z)):+.2f}°' for z in zs]}")
    print(f"   残差比={er:.4f} (旋转{ROT_T}° ⇒ 期望 sin={tgt_r:.4f})")
    ok1 = eg < 1e-3 and et < 0.5 and abs(er - tgt_r) < 0.02
    print(f"   {'✓ 机器精度' if ok1 else '✗'}")

    # ② Monte Carlo 400 seed
    NS = 400
    taus, zab, cov = [], [], 0
    for s in range(NS):
        A1, A2, Bp, Bm, _ = _synth(seq, G_T, TAU_T, ROT_T, NOISE, 1000 + s)
        rr = analyze_cfg(A1, A2, Bp, Bm, seq, verbose=False, nboot=200)
        taus.append(rr["tau_ms"])
        zab.append(np.mean([abs(rr["fr"][float(f)]["z"]) for f in freqs]))
        lo, hi = rr["fr"][float(freqs[0])]["z_abs_ci"]
        cov += int(lo <= G_T <= hi)
    taus, zab = np.array(taus), np.array(zab)
    tb, tsd = taus.mean() - TAU_T * 1e3, taus.std()
    ph_1s = tsd * 1e-3 * 7.0 * 360                     # 1σ 时延 → 7Hz 相位(度)
    print(f"\n② Monte Carlo ({NS} seed):")
    print(f"   τ 偏差 {tb:+.1f} ms · 1σ {tsd:.1f} ms · 95%区间 "
          f"[{np.percentile(taus,2.5):.0f},{np.percentile(taus,97.5):.0f}] ms")
    print(f"   等效相位 @7Hz: 偏差 {abs(tb)*1e-3*7*360:.0f}° · 1σ {ph_1s:.0f}°  (判据 1σ<30°)")
    print(f"   |z| = {zab.mean():.2f}±{zab.std():.2f} (真 {G_T})   "
          f"CI 覆盖率 {cov/NS*100:.0f}% (应≈95%)")
    ok2 = abs(tb) < 5 and ph_1s < 30 and 88 <= cov / NS * 100 <= 99
    print(f"   {'✓ 偏差与覆盖率达标' if ok2 else '✗ 不达标'}")

    # ③ 时钟抖动
    A1, A2, Bp, Bm, tsj = _synth(seq, G_T, TAU_T, ROT_T, NOISE, 7, jitter_ms=3.0)
    ru = analyze_cfg(A1, A2, Bp, Bm, seq, verbose=False, nboot=50)
    rj = analyze_cfg(A1, A2, Bp, Bm, seq, ts=tsj, verbose=False, nboot=50)
    print(f"\n③ 时钟抖动 3ms: 均匀假设 τ={ru['tau_ms']:+.0f}ms · "
          f"用真实时刻 τ={rj['tau_ms']:+.0f}ms  (真 {TAU_T*1e3:.0f})")
    ok3 = abs(rj["tau_ms"] - TAU_T * 1e3) < 3 * tsd + 5
    print(f"   {'✓ 时间戳处理有效' if ok3 else '✗'}")

    ok = ok1 and ok2 and ok3
    print(f"\n判决: {'✅ 三项验收通过 — 可放行 4mrad pilot' if ok else '❌ 未通过, 不放行'}")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--self-test", action="store_true")
    ap.add_argument("--eps", type=int, nargs="+", default=[0])
    a = ap.parse_args()
    if a.self_test:
        raise SystemExit(self_test())

    def load(ep, cfg):
        d = json.loads((PB / f"replay_ep{ep}_{cfg}.json").read_text())
        y = np.array(d["imu"], np.float32)[:, 3:6]
        check_recording(d.get("imu100", []), len(y) / FPS, name=f"ep{ep} {cfg}")
        return y

    for ep in a.eps:
        print(f"\n=== ep{ep} 记录质量 ===")
        A1, A2 = load(ep, "A1"), load(ep, "A2")
        for jn in JOINTS:
            for an in AMPS:
                try:
                    Bp, Bm = load(ep, f"{jn}_{an}_p"), load(ep, f"{jn}_{an}_m")
                except FileNotFoundError:
                    continue
                seq = np.load(PB / f"seq_ep{ep}_{jn}_{an}_p.npz", allow_pickle=True)
                analyze_cfg(A1, A2, Bp, Bm, seq, label=f"ep{ep} {jn} {an}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
